        { q: "पंचकार्ड का प्रयोग सर्वप्रथम किसने किया था?", options: ["ब्लेज पास्कल", "हर्मन होलेरिथ", "चार्ल्स बैबेज", "जॉन नेपियर"], ans: 1 },
        { q: "माइक्रो-कम्प्यूटर, मिनी-कम्प्यूटर, मेनफ्रेम और सुपर कम्प्यूटर किस आधार पर वर्गीकृत हैं?", options: ["कार्यप्रणाली", "आकार और क्षमता", "कीमत केवल", "ब्रांड"], ans: 1 },
        { q: "सर्वाधिक शक्तिशाली एवं तेज गति वाले कम्प्यूटर कहलाते हैं?", options: ["माइक्रो कम्प्यूटर", "मिनी कम्प्यूटर", "सुपर कम्प्यूटर", "मेनफ्रेम कम्प्यूटर"], ans: 2 },
        { q: "डेस्कटॉप, लैपटॉप और स्मार्टफोन किस श्रेणी के कम्प्यूटर हैं?", options: ["सुपर कम्प्यूटर", "मेनफ्रेम कम्प्यूटर", "माइक्रो कम्प्यूटर", "मिनी कम्प्यूटर"], ans: 2 },
        { q: "डिजिटल कम्प्यूटर किस सिद्धांत पर कार्य करते हैं?", options: ["लगातार सिग्नल", "गणना (Ginti / Binary 0 and 1)", "तापमान", "दबाव"], ans: 1 },
        { q: "एनालॉग एवं डिजिटल दोनों के सम्मिश्रण से बने कम्प्यूटर कहलाते हैं?", options: ["डिजिटल", "एनालॉग", "हाइब्रिड कम्प्यूटर (Hybrid Computer)", "सुपर कम्प्यूटर"], ans: 2 },
        { q: "कम्प्यूटर की मुख्य विशेषताएँ हैं?", options: ["गति (Speed)", "सटीकता (Accuracy)", "विश्वसनीयता (Reliability)", "उपर्युक्त सभी"], ans: 3 },
        { q: "सुपर कम्प्यूटर 'C-DAC' संस्था द्वारा कहाँ विकसित किया गया?", options: ["नई दिल्ली", "पुणे", "मुंबई", "बेंगलुरु"], ans: 1 },
        { q: "सूचना प्रौद्योगिकी (IT) का मुख्य घटक क्या है?", options: ["कम्प्यूटर तकनीक", "संचार तकनीक", "डेटा एवं सूचना", "उपर्युक्त सभी"], ans: 3 },
        { q: "बैंकों में चेक को जल्दी पढ़ने हेतु किस इनपुट डिवाइस का उपयोग होता है?", options: ["OMR", "MICR", "OCR", "Bar Code Reader"], ans: 1 },
        { q: "प्रतियोगी परीक्षाओं की उत्तरपुस्तिकाएँ (OMR Sheet) जाँचने के लिए उपयोग होता है?", options: ["MICR", "OMR", "OCR", "स्कैनर"], ans: 1 }
    ];

    let currentStudent = {};

    window.onload = function() {
        checkExistingAttempt();
    };

    function checkExistingAttempt() {
        const attempted = localStorage.getItem('rbse_it_ch1_attempted');
        if (attempted === 'true') {
            document.getElementById('studentFormCard').classList.add('hidden');
            document.getElementById('quizSection').classList.add('hidden');
            document.getElementById('lockCard').style.display = 'block';
            
            const savedStudent = JSON.parse(localStorage.getItem('rbse_it_ch1_last_student') || '{}');
            if (savedStudent.id) {
                document.getElementById('lockMessage').innerText = `Student ID: ${savedStudent.id} (${savedStudent.name}) द्वारा उत्तर पहले ही जमा किए जा चुके हैं।`;
            }
        }
    }

    function startTest() {
        const sId = document.getElementById('studentId').value.trim();
        const sName = document.getElementById('studentName').value.trim();

        if (!sId || !sName) {
            alert("कृपया Student ID और अपना नाम दोनों दर्ज करें!");
            return;
        }

        currentStudent = { id: sId, name: sName };
        document.getElementById('displayStudentId').innerText = sId;
        document.getElementById('displayStudentName').innerText = sName;

        document.getElementById('studentFormCard').classList.add('hidden');
        document.getElementById('quizSection').classList.remove('hidden');

        renderQuestions();
    }

    function renderQuestions() {
        const container = document.getElementById('questionsContainer');
        container.innerHTML = '';

        questionsData.forEach((item, index) => {
            const qBox = document.createElement('div');
            qBox.className = 'question-item';
            qBox.id = `qbox_${index}`;

            let optionsHtml = '';
            item.options.forEach((opt, oIndex) => {
                optionsHtml += `
                    <label>
                        <input type="radio" name="q_${index}" value="${oIndex}">
                        ${String.fromCharCode(65 + oIndex)}. ${opt}
                    </label>
                `;
            });

            qBox.innerHTML = `
                <div class="question-title">प्रश्न ${index + 1}. ${item.q}</div>
                <div class="options">${optionsHtml}</div>
                <div class="answer-key" id="ans_key_${index}">
                    <strong>सही उत्तर:</strong> ${String.fromCharCode(65 + item.ans)}. ${item.options[item.ans]}
                </div>
            `;
            container.appendChild(qBox);
        });
    }

    function submitQuiz() {
        let score = 0;
        let answeredCount = 0;

        questionsData.forEach((item, index) => {
            const selected = document.querySelector(`input[name="q_${index}"]:checked`);
            if (selected) {
                answeredCount++;
                if (parseInt(selected.value) === item.ans) {
                    score++;
                }
            }
        });

        if (answeredCount < questionsData.length) {
            const confirmSubmit = confirm(`आपने केवल ${answeredCount} / ${questionsData.length} प्रश्नों के उत्तर दिए हैं। क्या आप निश्चित ही उत्तर जमा करना चाहते हैं?`);
            if (!confirmSubmit) return;
        }

        // Save Result in localStorage
        const resultRecord = {
            id: currentStudent.id,
            name: currentStudent.name,
            score: score,
            total: questionsData.length,
            percent: ((score / questionsData.length) * 100).toFixed(1),
            timestamp: new Date().toLocaleString('hi-IN')
        };

        let submissions = JSON.parse(localStorage.getItem('rbse_it_ch1_submissions') || '[]');
        submissions.push(resultRecord);
        localStorage.setItem('rbse_it_ch1_submissions', JSON.stringify(submissions));

        // Lock Student attempt
        localStorage.setItem('rbse_it_ch1_attempted', 'true');
        localStorage.setItem('rbse_it_ch1_last_student', JSON.stringify(currentStudent));

        document.getElementById('quizSection').classList.add('hidden');
        document.getElementById('resultCard').style.display = 'block';
    }

    // Teacher Panel Logic
    function openTeacherLogin() {
        const pin = prompt("शिक्षक पोर्टल खोलने के लिए पासवर्ड (PIN) दर्ज करें:");
        if (pin === "1234") {
            document.getElementById('teacherPanel').style.display = 'block';
            loadSubmissionsTable();
            window.scrollTo(0, document.body.scrollHeight);
        } else if (pin !== null) {
            alert("गलत पिन (Wrong PIN)!");
        }
    }

    function closeTeacherPanel() {
        document.getElementById('teacherPanel').style.display = 'none';
    }

    function loadSubmissionsTable() {
        const tbody = document.getElementById('submissionsTableBody');
        const submissions = JSON.parse(localStorage.getItem('rbse_it_ch1_submissions') || '[]');

        if (submissions.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">अभी तक कोई उत्तर जमा नहीं हुआ है।</td></tr>';
            return;
        }

        tbody.innerHTML = '';
        submissions.forEach(sub => {
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td><strong>${sub.id}</strong></td>
                <td>${sub.name}</td>
                <td>${sub.score} / ${sub.total}</td>
                <td>${sub.percent}%</td>
                <td><small>${sub.timestamp}</small></td>
            `;
            tbody.appendChild(tr);
        });
    }

    function toggleAnswerKeys() {
        const quizVis = document.getElementById('quizSection').classList.contains('hidden');
        if (quizVis) {
            document.getElementById('quizSection').classList.remove('hidden');
            document.getElementById('studentFormCard').classList.add('hidden');
            document.getElementById('lockCard').style.display = 'none';
            document.getElementById('resultCard').style.display = 'none';
            if (!document.getElementById('questionsContainer').hasChildNodes()) {
                renderQuestions();
            }
        }

        const keys = document.querySelectorAll('.answer-key');
        keys.forEach(k => {
            k.style.display = (k.style.display === 'block') ? 'none' : 'block';
        });
    }

    function clearAllData() {
        const confirmClear = confirm("क्या आप सभी जमा रिकॉर्ड्स और छात्र लॉक हटाना चाहते हैं?");
        if (confirmClear) {
            localStorage.removeItem('rbse_it_ch1_attempted');
            localStorage.removeItem('rbse_it_ch1_last_student');
            localStorage.removeItem('rbse_it_ch1_submissions');
            alert("समस्त डेटा री-सेट कर दिया गया है!");
            location.reload();
        }
    }
</script>

